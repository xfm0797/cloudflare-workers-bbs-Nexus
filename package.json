{
  "name": "cf-bbs",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight, high-performance forum community on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "ship": "node scripts/deploy.mjs",
    "ship:dry": "node scripts/deploy.mjs --dry-run",
    "guard": "node scripts/edge-guard.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply cf-bbs --local",
    "db:migrate:remote": "wrangler d1 migrations apply cf-bbs --remote",
    "db:seed": "wrangler d1 execute cf-bbs --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute cf-bbs --remote --file=./seed.sql",
    "db:reset": "node -e \"require('fs').rmSync('.wrangler/state/v3/d1',{recursive:true,force:true})\" && npm run db:migrate && npm run db:seed",
    "search:reindex": "node scripts/search-reindex.mjs",
    "demo": "node scripts/demo-data.mjs",
    "shot": "node scripts/shot-mobile.cjs",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.151.1"
  }
}
